# Docker Compose host-side settings (separate from backend/.env, the app's own config).
# Copy to `.env` in the repo root.

# Host ports. Every project on a machine needs its own (this machine: 5432/5433/3000 are taken).
POSTGRES_PORT=5440
BACKEND_PORT=4000

# 127.0.0.1 keeps Postgres and the API reachable only from this machine (put
# nginx/Caddy in front of the API). Only change this if you know why.
BIND_ADDRESS=127.0.0.1

# Database credentials used when the Postgres volume is FIRST created.
# Local dev can keep the defaults. PRODUCTION: set a long random password
# before the first `docker compose up` (changing it later needs ALTER USER).
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=classcourse_db
