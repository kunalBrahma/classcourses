# Student site — production (https://myclasscourse.in).
# On the server: copy to .env.production before `npm run build`.
# NEXT_PUBLIC_* values are baked into the build, so rebuild after changing them.

# The API as browsers reach it
NEXT_PUBLIC_API_URL=https://api.myclasscourse.in
# This site's own address (canonical links, sitemap, metadata fallback)
NEXT_PUBLIC_SITE_URL=https://myclasscourse.in
# Server-side reads go straight to the API on the same VPS (no HTTPS round trip).
# Production uses Docker instead (docker-compose.prod.yml sets http://backend:3000).
API_INTERNAL_URL=http://127.0.0.1:4150
