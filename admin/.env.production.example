# Admin panel — production (https://admin.myclasscourse.in).
# On the server: copy to .env.production before `npm run build`.
# NEXT_PUBLIC_* values are baked into the build, so rebuild after changing them.

# The API as browsers reach it
NEXT_PUBLIC_API_URL=https://api.myclasscourse.in
# The student website, for "View on site" links
NEXT_PUBLIC_SITE_URL=https://myclasscourse.in
