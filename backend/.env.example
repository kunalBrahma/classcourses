# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Matches docker-compose.yml's postgres service when run via `docker compose up`
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/classcourse_db"

# JWT Configuration
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# CORS Configuration
# Development: "*". Production: comma-separated exact origins (no paths) — "*" is refused.
#   CORS_ORIGIN=https://myclasscourse.in,https://www.myclasscourse.in,https://admin.myclasscourse.in
#   (production values: backend/.env.production.example)
CORS_ORIGIN=*

# Number of reverse proxies in front of the API (nginx/Caddy = 1, + Cloudflare = 2).
# Needed for correct client IPs (rate limits) and https URLs. "false" = none.
TRUST_PROXY=false

# Settings encryption (AES-256-GCM) for secrets saved from the admin panel.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# Cloudflare R2 — FALLBACK only. Normally configured in Admin → Settings → Storage
# (the database value wins when present).
STORAGE_TYPE="r2"
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Private bucket for premium notes (paid PDFs). Paid notes can't be published until this is set.
R2_PRIVATE_BUCKET_NAME=

# Email (SMTP) — FALLBACK only. Normally configured in Admin → Settings → Email.
# Gmail/Outlook need an app password. Port 465 → SMTP_SECURE=true, port 587 → false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Class Course"

# Public student site URL — used for links in emails (password reset, receipts)
FRONTEND_URL=http://localhost:3100

# Optional: database for `npm test` (default: DATABASE_URL with "_test" appended to the name)
# TEST_DATABASE_URL=

# Razorpay — FALLBACK only. Normally configured in Admin → Settings → Payments.
# Test keys start with rzp_test_, live keys with rzp_live_. The webhook secret is
# the one you set in Razorpay Dashboard → Webhooks for:
#   <API URL>/api/payments/webhook/razorpay   (events: payment.captured, payment.failed, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: `npm run seed` creates this ADMIN account if the email isn't registered yet.
# It never resets an existing user's password. Production requires 12+ characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional. Shared with the student site's server: its requests (sent as
# X-Internal-Key) skip the per-IP /api backstop. 32+ characters.
INTERNAL_API_KEY=
