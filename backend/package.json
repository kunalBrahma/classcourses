{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "description": "Node.js + Express + Prisma + TypeScript backend boilerplate",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "prisma": "prisma",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "create-admin": "ts-node --transpile-only scripts/create-admin.ts",
    "test": "ts-node --transpile-only scripts/prepare-test-db.ts && vitest run",
    "test:watch": "vitest",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "keywords": [
    "node",
    "express",
    "prisma",
    "typescript",
    "backend"
  ],
  "author": "Kunal Brahma",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "sanitize-html": "^2.17.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.8.0",
    "smtp-server": "^3.19.16",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
