# API — production (https://api.myclasscourse.in). Copy to backend/.env on the server.
# The API refuses to start in production with CORS_ORIGIN=*, a short JWT secret
# or a localhost FRONTEND_URL (src/config/env.ts).

NODE_ENV=production
PORT=3000

# NEW secrets for production — never reuse the development ones:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-hex-characters
# Back this key up: without it, saved R2/SMTP/Razorpay secrets can't be read.
SETTINGS_ENCRYPTION_KEY=replace-with-64-hex-characters

# The student site (with and without www) and the admin panel
CORS_ORIGIN=https://myclasscourse.in,https://www.myclasscourse.in,https://admin.myclasscourse.in

# Caddy/nginx in front = 1. Set 2 if Cloudflare's orange-cloud proxy is also on.
TRUST_PROXY=1

# Links in emails (password reset, receipts, sign-up codes)
FRONTEND_URL=https://myclasscourse.in

# Ignored under Docker Compose (built from the root .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classcourse_db

# R2_*, SMTP_*, RAZORPAY_* are optional fallbacks — normally entered in Admin → Settings.
