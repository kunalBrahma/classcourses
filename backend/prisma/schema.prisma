datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

// For ADMIN accounts (client requirements of 6 Nov 2026): SUPER = full access
// (the Founder; every admin from before helpers existed), HELPER = only the
// sections in User.adminPermissions. Ignored for students.
enum AdminLevel {
  SUPER
  HELPER
}

// Account state set by the admin (Users → actions). SUSPENDED until
// suspendedUntil (or until lifted when null); BLOCKED also stops the email
// registering again (BlockedEmail); DELETED = personal data erased, the row
// kept only for payment records.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String?
  // 10-digit Indian mobile number, asked for at sign-up (null for older accounts)
  phone              String?
  // Null for accounts made with Google, until they set one through "Forgot password"
  password           String?
  // Google's permanent ID for this person; set once they sign in with Google
  googleId           String?                 @unique
  // /register creates students with false until they enter the emailed code.
  // Defaults to true so older accounts, admins and seeded users count as verified.
  emailVerified      Boolean                 @default(true)
  role               Role                    @default(STUDENT)
  adminLevel         AdminLevel              @default(SUPER)
  // HELPER admins: the sections they may use ("content", "quiz_reports",
  // "notes_orders", "users", "support"); see src/config/adminAccess.ts
  adminPermissions   String[]                @default([])
  status             UserStatus              @default(ACTIVE)
  suspendedUntil     DateTime?
  // Why the admin suspended / blocked / deleted it (the student sees it for suspend/block)
  statusReason       String?
  statusChangedAt    DateTime?
  deletedAt          DateTime?
  // Bumped to sign the account out everywhere: access tokens carry it ("tv")
  tokenVersion       Int                     @default(0)
  // Student's preferred medium/class, used to open the site where they left off
  mediumId           String?
  medium             Medium?                 @relation(fields: [mediumId], references: [id], onDelete: SetNull)
  // The student's class (asked at sign-up / "complete your profile")
  classLevelId       String?
  classLevel         ClassLevel?             @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  // Asked at sign-up (client requirements of 6 Nov 2026). Null for accounts made
  // before that and for Google sign-ups, until "complete your profile".
  districtId         String?
  district           District?               @relation(fields: [districtId], references: [id], onDelete: Restrict)
  // Date only. Used only to know whether the student is under 18.
  dateOfBirth        DateTime?               @db.Date
  // Cached balance; the source of truth is the CoinTransaction ledger
  coins              Int                     @default(0)
  quizAttempts       QuizAttempt[]
  coinTxns           CoinTransaction[]
  orders             Order[]
  noteAccess         NoteAccess[]
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  emailCodes         EmailVerificationCode[]
  authCodes          AuthCode[]
  coinLots           CoinLot[]
  adminLogins        AdminLoginAttempt[]
  contactMessages    ContactMessage[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  parentalConsent    ParentalConsent?
  likes              Like[]
  savedItems         SavedItem[]
  notifications      Notification[]          @relation("NotificationTo")
  sentNotices        Notification[]          @relation("NotificationFrom")
  notificationReads  NotificationRead[]
  // Refer and Earn: the student's own code (made on first use), and where they
  // last opened the Refer page from (to spot self-referrals)
  referralCode       String?                 @unique
  referralSeenIp     String?
  referralSeenDevice String?
  referralsMade      Referral[]              @relation("ReferralsMade")
  referredBy         Referral?               @relation("ReferredBy")
}

enum ConsentStatus {
  // Link emailed to the parent; no answer yet
  PENDING
  GRANTED
  DECLINED
  // Given, then taken back (the parent asked; recorded by the admin)
  WITHDRAWN
}

// Parent or guardian consent for a student under 18 (client requirements of
// 6 Nov 2026; DPDP Act). One per student: asking a different parent replaces
// the request. Until GRANTED the account isn't fully active (no quizzes,
// coins or purchases). The decision is kept with when, how and from where.
model ParentalConsent {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentEmail      String
  status           ConsentStatus @default(PENDING)
  // sha256 of the emailed link's secret; null once decided
  tokenHash        String?       @unique
  expiresAt        DateTime
  lastSentAt       DateTime
  sendCount        Int           @default(1)
  // The parent's own answer (or the admin's record of it)
  parentName       String?
  relationship     String?
  decidedAt        DateTime?
  decidedVia       String?
  decidedIp        String?
  decidedUserAgent String?
  // Admin's note when recording or withdrawing consent
  adminNote        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

// Emails that may not create an account again (a blocked account's email).
// Removed when the admin unblocks.
model BlockedEmail {
  email       String   @id
  reason      String
  blockedById String?
  createdAt   DateTime @default(now())
}

// Everything an admin changes (and data exports), written by middleware on
// /api/admin (middleware/adminActivity.ts): who, what, when, why, before/after.
// Kept if the admin account is later removed. Secrets are never stored.
model AdminActivity {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String
  // e.g. "user.suspend", or "PATCH /chapters/:chapterId" when no name was given
  action     String
  method     String
  path       String
  targetType String?
  targetId   String?
  summary    String?
  reason     String?
  // Request (secrets removed, trimmed) and, where given, before/after values
  details    Json?
  statusCode Int
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Failed sign-ins, kept in the database so a restart, a page refresh or a new
// browser can't reset them (services/loginThrottle.service.ts). One row per
// key: "account:<email>" or "ip:<address>". The wait grows with lockLevel.
model LoginThrottle {
  key           String    @id
  // Failures in the current window (windowStart + loginWindowMinutes)
  failures      Int       @default(0)
  windowStart   DateTime  @default(now())
  lockedUntil   DateTime?
  // How many times it has been locked recently; each lock doubles the wait
  lockLevel     Int       @default(0)
  lastFailureAt DateTime  @default(now())

  @@index([lockedUntil])
}

enum AuthCodePurpose {
  RESET_PASSWORD
  UNLOCK_ACCOUNT
}

// 6-digit codes emailed for "forgot password" and "unlock my account". Only a
// hash is stored; valid exactly 5 minutes; a new code replaces the old one.
model AuthCode {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthCodePurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([userId, purpose])
}

enum AdminLoginResult {
  SUCCESS
  WRONG_PASSWORD
  LOCKED
  UNLOCK_CODE_SENT
  UNLOCKED
}

// Every sign-in attempt on an admin account (shown to the Founder in
// Admin → Security → Sign-in log). Kept if the account is deleted.
model AdminLoginAttempt {
  id        String           @id @default(uuid())
  email     String
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  result    AdminLoginResult
  ip        String
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Old emailed reset links. Replaced by AuthCode (RESET_PASSWORD) on 6 Nov
// 2026; nothing creates these any more.
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Key/value app configuration editable from the admin panel
// (storage, quiz rules, coins, social links, ...). Secrets inside `value`
// are stored encrypted — see src/utils/crypto.ts.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Districts students choose at sign-up (Assam's districts, admin-managed and
// extendable: never an enum). A district in use can be hidden, not deleted.
model District {
  id         String   @id @default(uuid())
  name       String   @unique
  nativeName String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

// ---------------------------------------------------------------------------
// Catalog: Medium → Class → Subject → (optional Part) → Chapter
// ---------------------------------------------------------------------------

// Admin-managed (Assamese Medium, English Medium, ...). Never hardcode the list.
model Medium {
  id         String    @id @default(uuid())
  name       String
  nativeName String?
  slug       String    @unique
  order      Int       @default(0)
  isActive   Boolean   @default(true)
  subjects   Subject[]
  users      User[]
  quizzes    Quiz[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Class 1–12, shared by every medium. A class shows under a medium only when
// that medium has active subjects in it.
// A class / grade, shared by every medium. Fully admin-managed: "Class 5",
// "LKG", "BA 1st Year" … The link part (slug) is used in student URLs
// (/assamese-medium/class-5/...). Order = position on the student site.
model ClassLevel {
  id            String         @id @default(uuid())
  name          String
  nativeName    String?
  slug          String         @unique
  order         Int            @default(0)
  isActive      Boolean        @default(true)
  subjects      Subject[]
  quizzes       Quiz[]
  users         User[]
  announcements Announcement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([order])
}

// Each medium has its own subject list per class.
model Subject {
  id           String        @id @default(uuid())
  mediumId     String
  medium       Medium        @relation(fields: [mediumId], references: [id], onDelete: Cascade)
  classLevelId String
  classLevel   ClassLevel    @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  name         String
  nativeName   String?
  slug         String
  order        Int           @default(0)
  isActive     Boolean       @default(true)
  parts        SubjectPart[]
  chapters     Chapter[]
  notes        Note[]
  quizzes      Quiz[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([mediumId, classLevelId, slug])
  @@index([mediumId, classLevelId, order])
}

// Optional grouping inside a subject: "Part 1", "Book 2", "Writing Skills".
model SubjectPart {
  id        String    @id @default(uuid())
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  order     Int       @default(0)
  chapters  Chapter[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([subjectId, order])
}

// `order` is the position within its part (or within the no-part group).
// Reading order across the subject = no-part chapters first, then each part
// by SubjectPart.order — see src/services/catalog.service.ts.
model Chapter {
  id           String        @id @default(uuid())
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  partId       String?
  part         SubjectPart?  @relation(fields: [partId], references: [id], onDelete: SetNull)
  number       Int
  title        String
  slug         String
  order        Int           @default(0)
  aboutHtml    String?
  isPublished  Boolean       @default(true)
  // The automatic chapter quiz (random quiz-marked MCQs). Off = only custom quizzes.
  autoQuiz     Boolean       @default(true)
  questions    Question[]
  videos       Video[]
  quizAttempts QuizAttempt[]
  notes        Note[]
  quizChapters QuizChapter[]
  homeQuizzes  Quiz[]        @relation("QuizHomeChapter")
  likes        Like[]
  savedBy      SavedItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId, partId, order])
}

// ---------------------------------------------------------------------------
// Chapter content
// ---------------------------------------------------------------------------

enum QuestionKind {
  QA
  MCQ
}

// TEXTBOOK = from the school book; EXTRA = "extra advanced" beyond the book
enum QuestionSource {
  TEXTBOOK
  EXTRA
}

// Client decision PENDING (task.md #7) — optional until decided.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Rich-text fields (question, answer, explanation) hold SANITISED HTML only —
// see src/utils/sanitizeHtml.ts. MCQ answers are never sent with the public
// chapter payload (the quiz reuses these questions).
model Question {
  id           String         @id @default(uuid())
  chapterId    String
  chapter      Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  kind         QuestionKind
  source       QuestionSource @default(TEXTBOOK)
  question     String
  // QA only
  answer       String?
  // MCQ only: array of 2–6 option strings (sanitised HTML) + 0-based correct index
  options      Json?
  correctIndex Int?
  explanation  String?
  difficulty   Difficulty?
  order        Int            @default(0)
  isPublished  Boolean        @default(true)
  // MCQ only: may appear in quizzes (automatic ones, and random custom ones
  // that use "quiz-marked only"). Off = practice on the chapter page only.
  useInQuiz    Boolean        @default(true)
  quizPicks    QuizQuestion[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([chapterId, source, kind, order])
}

enum VideoFormat {
  LANDSCAPE
  SHORT
}

// YouTube embed (Class Course channel). Order is per chapter.
model Video {
  id         String      @id @default(uuid())
  chapterId  String
  chapter    Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  youtubeId  String
  // SHORT = vertical 9:16 YouTube Short, LANDSCAPE = normal 16:9 video.
  // Detected from a /shorts/ link on save; the admin can change it.
  format     VideoFormat @default(LANDSCAPE)
  // Set = shown in the home page "Videos" row (newest first); null = not.
  featuredAt DateTime?
  title      String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([chapterId, order])
}

// ---------------------------------------------------------------------------
// Quiz & coins
// ---------------------------------------------------------------------------

enum QuizStatus {
  IN_PROGRESS
  PAUSED
  PASSED
  FAILED
  EXPIRED
}

// Server-timed quiz. A question's clock starts when the server reveals it
// (questionDeadline); answers after the deadline count as wrong. Pausing while
// a question is revealed forfeits that question. Unfinished attempts expire at
// midnight Asia/Kolkata (dayKey). See src/services/quiz.service.ts.
model QuizAttempt {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set for automatic chapter quizzes and single-chapter custom quizzes
  chapterId          String?
  chapter            Chapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  // Custom quiz (null = the automatic chapter quiz). The title is kept so
  // history still reads well after the quiz is deleted.
  quizId             String?
  quiz               Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizTitle          String?
  // IST calendar day the attempt was started, "YYYY-MM-DD"
  dayKey             String
  status             QuizStatus   @default(IN_PROGRESS)
  // Question ids in the order they are asked (fixed at start)
  questionIds        Json
  // One entry per answered question: { optionIndex, correct, timedOut, answeredAt }
  answers            Json         @default("[]")
  currentIndex       Int          @default(0)
  // Set while a question is revealed; null between questions / when paused
  questionDeadline   DateTime?
  score              Int          @default(0)
  // Rules at start time, so admin edits don't change a running quiz
  secondsPerQuestion Int
  passMark           Int
  coinsPerPass       Int?
  answerReveal       AnswerReveal @default(AFTER_EACH)
  // Shuffled options: per question, display position → original option index
  optionOrders       Json?
  coinsAwarded       Int          @default(0)
  startedAt          DateTime     @default(now())
  finishedAt         DateTime?
  updatedAt          DateTime     @updatedAt

  @@index([userId, dayKey])
  @@index([userId, chapterId, status])
  // Admin quiz reports (filters by day and per-chapter stats)
  @@index([dayKey])
  @@index([chapterId, status])
  @@index([userId, quizId, status])
  @@index([quizId, status])
}

enum QuizPickMode {
  // N random questions from the chapters' pool (with filters / difficulty mix)
  RANDOM
  // Exactly the hand-picked questions (QuizQuestion), optionally shuffled
  FIXED
}

enum AnswerReveal {
  AFTER_EACH
  AT_END
  NEVER
}

// A quiz built by the admin from any chapters of ONE medium + class. Every
// rule left null falls back to Settings → Quiz & coins.
// Rules live in src/services/quizBuilder.service.ts.
model Quiz {
  id                    String           @id @default(uuid())
  title                 String
  description           String?
  mediumId              String
  medium                Medium           @relation(fields: [mediumId], references: [id], onDelete: Cascade)
  classLevelId          String
  classLevel            ClassLevel       @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  // Where students find it: the one chapter / the one subject / else the class page
  subjectId             String?
  subject               Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapterId             String?
  chapter               Chapter?         @relation("QuizHomeChapter", fields: [chapterId], references: [id], onDelete: SetNull)
  chapters              QuizChapter[]
  questions             QuizQuestion[]
  attempts              QuizAttempt[]
  pickMode              QuizPickMode     @default(RANDOM)
  questionCount         Int?
  // RANDOM filters; empty = any
  sources               QuestionSource[]
  difficulties          Difficulty[]
  // Optional exact mix, e.g. {"EASY":4,"MEDIUM":4,"HARD":2}
  difficultyMix         Json?
  onlyQuizMarked        Boolean          @default(true)
  secondsPerQuestion    Int?
  passMark              Int?
  coinsPerPass          Int?
  shuffleQuestions      Boolean          @default(true)
  shuffleOptions        Boolean          @default(false)
  answerReveal          AnswerReveal     @default(AFTER_EACH)
  maxAttemptsPerStudent Int?
  availableFrom         DateTime?
  availableUntil        DateTime?
  isPublished           Boolean          @default(false)
  order                 Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([mediumId, classLevelId])
  @@index([subjectId])
  @@index([chapterId])
}

model QuizChapter {
  quizId    String
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([quizId, chapterId])
  @@index([chapterId])
}

// Hand-picked questions of a FIXED quiz, in order
model QuizQuestion {
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@id([quizId, questionId])
  @@index([questionId])
}

enum CoinReason {
  QUIZ_PASS
  // Coins held when a note order is created (refId = Order id)
  NOTE_DISCOUNT
  // Held coins returned when that order is cancelled/abandoned (refId = Order id)
  NOTE_DISCOUNT_REFUND
  // Paid after the order had been cancelled (and its held coins refunded): the
  // discount was used after all, so the coins are taken again (refId = Order id)
  NOTE_DISCOUNT_REAPPLIED
  ADMIN_ADJUST
  // Refer and Earn (refId = Referral id): the inviter's reward, the new friend's
  // welcome bonus, and taking a reward back when fraud is found
  REFERRAL_REWARD
  REFERRAL_BONUS
  REFERRAL_REVERSED
  // Coins are valid for 90 days from the day they are credited (refId = "<lotId>:<n>")
  COIN_EXPIRED
}

// Append-only coin ledger. User.coins is a cache of the running total.
// (reason, refId) is unique so the same quiz/order can never pay out twice.
model CoinTransaction {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       CoinReason
  // QuizAttempt id / Order id; null for admin adjustments
  refId        String?
  note         String?
  createdById  String?
  createdAt    DateTime   @default(now())

  lot   CoinLot?
  moves CoinLotMove[]

  @@unique([reason, refId])
  @@index([userId, createdAt])
}

// One credit of coins (a quiz pass, an admin top-up), valid until expiresAt
// (client requirements of 6 Nov 2026: 90 days from the day credited, each
// credit separately; new coins never extend older ones). Spending takes from
// the lot that expires first. User.coins always equals the sum of `remaining`.
model CoinLot {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The ledger row that credited it
  creditTxId    String          @unique
  creditTx      CoinTransaction @relation(fields: [creditTxId], references: [id], onDelete: Cascade)
  amount        Int
  remaining     Int
  creditedAt    DateTime
  expiresAt     DateTime
  // Coins of this lot that have expired so far, and how many expiry rows were written
  expiredAmount Int             @default(0)
  expiryCount   Int             @default(0)
  moves         CoinLotMove[]

  @@index([userId, expiresAt])
  @@index([expiresAt, remaining])
}

// Which lots a ledger row took coins from (negative) or gave them back to
// (positive). Held coins that come back (a cancelled order, a duplicate
// payment) return to the same lots, with their original expiry dates.
model CoinLotMove {
  id     String          @id @default(uuid())
  txId   String
  tx     CoinTransaction @relation(fields: [txId], references: [id], onDelete: Cascade)
  lotId  String
  lot    CoinLot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  amount Int

  @@index([txId])
  @@index([lotId])
}

// ---------------------------------------------------------------------------
// Premium notes & payments (Razorpay)
// ---------------------------------------------------------------------------

// A PDF attached to a chapter or a whole subject. The file lives in the
// PRIVATE R2 bucket and is only ever served through short-lived signed URLs.
model Note {
  id          String       @id @default(uuid())
  title       String
  description String?
  chapterId   String?
  chapter     Chapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Price in paise (₹49 = 4900). Ignored when isFree.
  pricePaise  Int          @default(0)
  isFree      Boolean      @default(false)
  // Object key in the private bucket; null until a PDF is uploaded
  fileKey     String?
  fileSize    Int?
  isPublished Boolean      @default(false)
  order       Int          @default(0)
  orders      Order[]
  access      NoteAccess[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([chapterId])
  @@index([subjectId])
}

enum OrderStatus {
  CREATED
  PAID
  // Abandoned or replaced before payment; held coins were refunded
  CANCELLED
  // Paid, then the money went back (duplicate payment, or a refund from the
  // Razorpay dashboard); access from this order is removed
  REFUNDED
}

model Order {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  noteId              String
  note                Note        @relation(fields: [noteId], references: [id], onDelete: Restrict)
  listPricePaise      Int
  coinsUsed           Int         @default(0)
  discountPaise       Int         @default(0)
  // What the student actually pays (listPrice − discount); 0 = fully covered by coins
  amountPaise         Int
  currency            String      @default("INR")
  status              OrderStatus @default(CREATED)
  // Which gateway took (or will take) the payment: "cashfree" | "razorpay".
  // Orders from before Cashfree were all Razorpay.
  provider            String      @default("razorpay")
  // Cashfree: its order id is our Order.id; the browser needs the session id
  cashfreeSessionId   String?
  // Cashfree's cf_payment_id of the successful payment
  cashfreePaymentId   String?     @unique
  razorpayOrderId     String?     @unique
  razorpayPaymentId   String?     @unique
  paidAt              DateTime?
  // The gateway's refund id once the money went back (details in Refund)
  refundId            String?     @unique
  refundedAt          DateTime?
  // How the payment was confirmed: "verify" | "webhook" | "reconcile" | "coins"
  confirmedVia        String?
  // When the student ticked "a parent or guardian has permitted this purchase"
  // at checkout (null for orders from before the box existed)
  purchaseConfirmedAt DateTime?
  lastError           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  access              NoteAccess?
  refunds             Refund[]

  @@index([userId, noteId, status])
  @@index([status, createdAt])
}

enum RefundStatus {
  // Asked for; the gateway hasn't confirmed it yet
  PENDING
  // The gateway confirmed the money went back
  SUCCESS
  // The gateway refused it or it couldn't be started (see failureReason)
  FAILED
}

enum RefundReason {
  // The same note was paid for twice (refunded automatically, coins back too)
  DUPLICATE
  // Started by the admin (Orders → Refund), with a written reason
  ADMIN
  // Made in the gateway's own dashboard and reported by webhook
  GATEWAY
}

// A refund of an order's money (client requirements of 6 Nov 2026). An order
// becomes REFUNDED, and loses the access it gave, only when the gateway
// confirms SUCCESS — never because a refund was merely asked for.
model Refund {
  id               String       @id @default(uuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider         String
  // The gateway's own reference (Cashfree cf_refund_id / Razorpay refund id)
  providerRefundId String?      @unique
  amountPaise      Int
  status           RefundStatus @default(PENDING)
  reason           RefundReason
  // The admin's written reason, or what happened
  note             String?
  failureReason    String?
  createdById      String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

// Who may download which note. One row per user+note, created only when an
// order is confirmed PAID (or by an admin grant).
model NoteAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  grantedAt DateTime @default(now())

  @@unique([userId, noteId])
}

// ---------------------------------------------------------------------------
// Static pages (About, Contact, Privacy, Terms, Refund policy) and FAQ
// ---------------------------------------------------------------------------

// One row per known page slug (see src/services/pages.service.ts). bodyHtml is
// sanitised on save and may contain {{tokens}} filled from live settings.
model Page {
  slug        String   @id
  title       String
  bodyHtml    String
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// "Latest news" links on the home page (external sites, admin-managed).
// Home page banner slideshow (admin → Home banners). Images are never cropped, so
// their real sizes are stored: the browser reserves the right space before they load.
model Banner {
  id             String   @id @default(uuid())
  // What the banner says, for screen readers; "" when the admin leaves it empty
  altText        String
  // Main (landscape) picture, plus a half-size copy for small screens
  imageUrl       String
  imageSmallUrl  String
  width          Int
  height         Int
  // Optional separate picture for phones
  mobileImageUrl String?
  mobileWidth    Int?
  mobileHeight   Int?
  // A page on this site ("/notes") or a full http(s) link; null = not clickable
  link           String?
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

model NewsLink {
  id        String   @id @default(uuid())
  source    String
  title     String
  url       String
  // Picture for the card (public bucket upload or any https image); optional
  imageUrl  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model FaqItem {
  id          String   @id @default(uuid())
  question    String
  answerHtml  String
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// One-time 6-digit code that proves a new student owns their email.
// Only a hash is stored; a new code replaces the old one.
model EmailVerificationCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// A message from the website's contact form. Saved first (the admin always
// sees it in Admin → Messages); the notification email goes out afterwards.
model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  // Optional 10-digit mobile number, if the student gave one
  phone     String?
  topic     String
  message   String
  status    ContactStatus @default(NEW)
  // Set when sent while signed in
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Notification email result, for the admin ("sent" / the error)
  emailNote String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Like, Save, Share; blog; announcements; notifications (Phase 14, client
// requirements of 6 Nov 2026)
// ---------------------------------------------------------------------------

// One like per student and item. The item is a chapter page or a blog post:
// exactly one of chapterId / blogPostId is set (checked in reaction.service.ts).
model Like {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blogPostId String?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, chapterId])
  @@unique([userId, blogPostId])
  @@index([chapterId])
  @@index([blogPostId])
  @@index([createdAt])
}

// Profile → Saved. Same shape as Like.
model SavedItem {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blogPostId String?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, chapterId])
  @@unique([userId, blogPostId])
  @@index([userId, createdAt])
  @@index([chapterId])
  @@index([blogPostId])
}

model BlogCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([order])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  // Short summary for cards and search results ("" = taken from the text)
  excerpt        String        @default("")
  // Sanitised HTML (src/utils/sanitizeHtml.ts)
  bodyHtml       String
  // Featured image (public bucket); its size is kept so it's never cropped on the post page
  coverImageUrl  String?
  coverWidth     Int?
  coverHeight    Int?
  coverAlt       String        @default("")
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         BlogStatus    @default(DRAFT)
  // Set the first time it's published; the admin can change it
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  likes          Like[]
  savedBy        SavedItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

enum AnnouncementAudience {
  // Everyone, signed in or not (home page)
  EVERYONE
  // Signed-in students only (optionally one class)
  STUDENTS
}

model Announcement {
  id           String               @id @default(uuid())
  title        String
  // Sanitised HTML
  bodyHtml     String               @default("")
  imageUrl     String?
  imageWidth   Int?
  imageHeight  Int?
  // A page on this site ("/notes") or a full http(s) link
  link         String?
  linkLabel    String?
  audience     AnnouncementAudience @default(EVERYONE)
  // STUDENTS only: just this class (null = every class)
  classLevelId String?
  classLevel   ClassLevel?          @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  isPublished  Boolean              @default(false)
  // Optional window; null = from now / no end
  startsAt     DateTime?
  endsAt       DateTime?
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isPublished, order])
}

enum NotificationKind {
  // A message from the team (one student or everyone)
  NOTICE
  // "Warn the user" (moderation): one student only
  WARNING
  // Sent by the site itself: refunds, parent's permission, coin changes
  ACCOUNT
}

// The bell inbox. userId null = every student (sent to all).
model Notification {
  id        String             @id @default(uuid())
  userId    String?
  user      User?              @relation("NotificationTo", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  // Plain text
  body      String
  link      String?
  // The admin who sent it (null = the site)
  sentById  String?
  sentBy    User?              @relation("NotificationFrom", fields: [sentById], references: [id], onDelete: SetNull)
  // One student: "also email it" result ("sent" / the error), null = not emailed
  emailNote String?
  reads     NotificationRead[]
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Refer and Earn (Phase 15, client requirements of 6 Nov 2026)
// ---------------------------------------------------------------------------

enum ReferralStatus {
  // Signed up through the link; email not verified yet
  PENDING
  // Coins given
  REWARDED
  // Looks suspicious (same device, many sign-ups, daily cap…): waits for the Founder
  HELD
  // No coins (email already rewarded, the inviter's account refused, or the Founder said no)
  REJECTED
  // Coins taken back after fraud was found
  REVERSED
}

model Referral {
  id            String         @id @default(uuid())
  referrerId    String
  referrer      User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  // One referral per new account
  referredId    String         @unique
  referred      User           @relation("ReferredBy", fields: [referredId], references: [id], onDelete: Cascade)
  // SHA-256 of the normalised email: an email earns a reward once, even after the account is erased
  emailHash     String
  status        ReferralStatus @default(PENDING)
  // Why it was held or rejected, in plain words
  reason        String?
  coinsReferrer Int            @default(0)
  coinsFriend   Int            @default(0)
  // Signals for the fraud review
  signupIp      String?
  deviceId      String?
  userAgent     String?
  verifiedAt    DateTime?
  decidedAt     DateTime?
  decidedById   String?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([referrerId, createdAt])
  @@index([status, createdAt])
  @@index([emailHash])
  @@index([signupIp])
  @@index([deviceId])
}
